# ============================================================
# GenPerp — Leveraged Perpetual Exchange — Environment Template
# Copy this file to .env and fill in your values
# ============================================================

# PerpExchange contract address (filled after `npm run deploy`)
CONTRACT_ADDRESS=

# GenLayer RPC
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Backend/keeper wallet private key (without 0x prefix).
# This key only ever calls the permissionless keeper actions
# (touch_price / liquidate_position / settle_funding) plus
# whatever admin script you run by hand (deploy, fund-vault,
# add_market). It never spends on a trader's behalf.
PRIVATE_KEY=

# How often the keeper sweeps markets (ms). Also read by backend-proxy.js.
# Each sweep sends one touch_price tx per market, so this is a direct gas cost.
KEEPER_INTERVAL_MS=60000

# Port for the local backend-proxy HTTP server
PORT=3005

# LLM Provider Keys (at least one required for validators)
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# Heurist AI (free tier: https://heurist.ai)
HEURISTAI_API_KEY=
