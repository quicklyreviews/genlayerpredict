# ============================================================
# GenLayer BTC Up/Down Market — Environment Template
# Copy this file to .env and fill in your values
# ============================================================

# Contract address (filled after deploy)
CONTRACT_ADDRESS=

# GenLayer RPC
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Backend wallet private key (without 0x prefix)
PRIVATE_KEY=

# LLM Provider Keys (at least one required for validators)
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# Heurist AI (free tier: https://heurist.ai)
HEURISTAI_API_KEY=
